{
	"name": "pi-magpie-bot",
	"version": "0.1.0",
	"private": true,
	"description": "An always-on personal assistant with memory and reminders: free models out of the box, your data on your own machine.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mazihua-lgtm/pi-magpie-bot.git"
	},
	"homepage": "https://github.com/mazihua-lgtm/pi-magpie-bot#readme",
	"bugs": {
		"url": "https://github.com/mazihua-lgtm/pi-magpie-bot/issues"
	},
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node apps/bot/src/main.ts",
		"build": "pnpm -r --if-present run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoke": "tsx scripts/smoke-gateway.ts",
		"smoke:bot": "tsx scripts/smoke-bot.ts",
		"smoke:durable": "tsx scripts/smoke-durable.ts",
		"e2e": "bash scripts/e2e/run.sh"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsup": "^8.5.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.5.2",
		"@earendil-works/pi-ai": "^1.5.2",
		"@earendil-works/pi-durable": "^1.5.2",
		"@earendil-works/pi-schema": "^1.5.2"
	}
}
