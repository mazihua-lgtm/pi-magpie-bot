# 复制成 .env 就能用；每一项都有默认值，不改也能跑。
# Copy to .env; every line has a default, so an untouched file still works.

# 数据放哪里（对话、记忆、定时任务都在这里）
DATA_DIR=~/.pi-magpie-bot

# 本地时区，提醒和时间都按它算；Docker 里默认 UTC，要在 compose 里给 TZ
TZ=Asia/Shanghai

# 用哪个模型。group/free 是免费路由组，不花一分钱；进阶用户填自己的模型，例如 auto/claude-haiku-5-5
MAGPIE_MODEL=group/free

# magpie 网关地址。本机默认就是它；单容器的 compose 不用管，只有 compose.split.yml 里改成 http://magpie:3425
MAGPIE_BASE_URL=http://127.0.0.1:3425
MAGPIE_API_KEY=magpie
# 设成 0 就只连、不自己启动 magpie（magpie 跑在别的容器/别的机器上时用）
MAGPIE_START=1

# 网页聊天。只给本机用就别动 HOST；放到公网一定要设 WEB_PASSWORD
WEB_PORT=8787
WEB_HOST=127.0.0.1
WEB_PASSWORD=
# 只对 docker compose 有用：网页端口发布到哪个地址。默认只本机能打开；
# 要让别的设备访问，改成 0.0.0.0，并且一定要设上面的 WEB_PASSWORD
WEB_BIND=127.0.0.1
# 手机扫码配对时二维码里写的地址。留空就自动探测局域网 IP；
# 电脑有多个网卡或探测不对时，手动填手机能访问的那个 IP 或域名
PAIR_HOST=

# Telegram：在 @BotFather 那里新建机器人，把 token 粘在这里就会自动连上
TELEGRAM_BOT_TOKEN=
# api.telegram.org 连不上时填一个镜像地址
TELEGRAM_API_BASE=

# 飞书（Lark）：在 open.feishu.cn 建一个企业自建应用，开启「机器人」能力，
# 事件订阅选「使用长连接接收事件」并加上 im.message.receive_v1，再发布版本。
# 把应用的 App ID 和 App Secret 填在这里；不需要公网地址。国际版 Lark 把 DOMAIN 改成 lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu

# 企业微信（微信里的「企业微信」应用，不是个人微信）：管理后台 → 安全与管理 → 管理工具 →
# 智能机器人 → 创建，选「API 模式」的「长连接」，把 Bot ID 和 Secret 填在这里；不需要公网地址
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 邮箱（Gmail，IMAP 只读）：Google 账号开两步验证后，在「应用专用密码」里生成一个密码填在下面。
# 填了之后助理能查、读你的邮件，并每 5 分钟检查一次未读邮件，有新的就告诉你。不填就不启用。
# Gmail (read-only over IMAP): create an app password after enabling 2-step verification, paste it below.
# Leave blank to disable. The bot checks unread mail every 5 minutes once it is wired in.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true

# 让助理能读写这台机器（可选，危险）。填一个目录后它才能用 read/write/bash，
# 而且每次都要在聊天里回「是」才真的执行。留空就是完全只读聊天。
WORKSPACE_DIR=

# 除主人之外还允许谁说话，逗号分隔的平台用户 id
ALLOWED_USERS=

# 多久兜底扫一遍待办（重试到期、补偿触发等）。消息本身是事件驱动到达的，
# 这个值不影响响应速度；默认 30 秒在手机上足够省电。最小 1000。
TICK_MS=30000
