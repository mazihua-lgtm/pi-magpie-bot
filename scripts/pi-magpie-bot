#!/usr/bin/env bash
# pi-magpie-bot: look after the assistant that get.sh installed.
#
#   pi-magpie-bot status | start | stop | restart | logs | open | url
#   pi-magpie-bot enable      start now and at every login
#   pi-magpie-bot disable     stop starting at login
#   pi-magpie-bot update      fetch the newest version
#   pi-magpie-bot uninstall   remove it (your chats and memory stay unless --purge)
set -euo pipefail

SELF="$0"
[ -L "$SELF" ] && SELF="$(readlink "$SELF")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
LOG="$ROOT/bot.log"
PIDFILE="$ROOT/bot.pid"
LABEL="com.pi-magpie-bot"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UNIT_DIR="$HOME/.config/systemd/user"
UNIT="$UNIT_DIR/pi-magpie-bot.service"
UID_NUM="$(id -u)"

say() { printf '\033[1m→\033[0m %s\n' "$*"; }
die() { printf '\033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

OS="$(uname -s)"

use_launchd() { [ "$OS" = Darwin ] && command -v launchctl >/dev/null 2>&1; }
use_systemd() {
	[ "$OS" = Linux ] && command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

# The port the chat page listens on: .env wins, else the default.
port() {
	local p=""
	[ -f "$ROOT/app/.env" ] && p="$(sed -n 's/^WEB_PORT=\([0-9][0-9]*\).*/\1/p' "$ROOT/app/.env" | tail -n 1)"
	echo "${p:-8787}"
}
url() { echo "http://127.0.0.1:$(port)"; }

# A log that only ever grows fills a disk on a machine that never stops.
rotate_log() {
	if [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 10485760 ]; then mv -f "$LOG" "$LOG.1"; fi
}

# Every process below a pid, deepest first, so none is left running after a stop.
tree() {
	local child
	for child in $(pgrep -P "$1" 2>/dev/null || true); do tree "$child"; done
	echo "$1"
}

write_plist() {
	mkdir -p "$(dirname "$PLIST")"
	cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>$LABEL</string>
	<key>ProgramArguments</key><array><string>$ROOT/run.sh</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ThrottleInterval</key><integer>10</integer>
	<key>StandardOutPath</key><string>$LOG</string>
	<key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
}

write_unit() {
	mkdir -p "$UNIT_DIR"
	cat >"$UNIT" <<EOF
[Unit]
Description=pi-magpie-bot personal assistant

[Service]
ExecStart=$ROOT/run.sh
Restart=always
RestartSec=10
StandardOutput=append:$LOG
StandardError=append:$LOG

[Install]
WantedBy=default.target
EOF
}

is_running() {
	if use_launchd && [ -f "$PLIST" ]; then
		launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1
	elif use_systemd && [ -f "$UNIT" ]; then
		systemctl --user is-active --quiet pi-magpie-bot
	else
		[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
	fi
}

start_bare() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then return 0; fi
	(nohup "$ROOT/run.sh" >>"$LOG" 2>&1 & echo $! >"$PIDFILE")
}

stop_bare() {
	[ -f "$PIDFILE" ] || return 0
	local pid pids
	pid="$(cat "$PIDFILE")"
	if kill -0 "$pid" 2>/dev/null; then
		pids="$(tree "$pid")"
		# shellcheck disable=SC2086
		kill $pids 2>/dev/null || true
		sleep 2
		# shellcheck disable=SC2086
		kill -9 $pids 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
}

do_start() {
	rotate_log
	if use_launchd && [ -f "$PLIST" ]; then
		launchctl bootout "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || true
		launchctl bootstrap "gui/$UID_NUM" "$PLIST"
	elif use_systemd && [ -f "$UNIT" ]; then
		systemctl --user daemon-reload
		systemctl --user restart pi-magpie-bot
	else
		start_bare
	fi
}

do_stop() {
	if use_launchd && [ -f "$PLIST" ]; then
		launchctl bootout "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || true
	elif use_systemd && [ -f "$UNIT" ]; then
		systemctl --user stop pi-magpie-bot || true
	fi
	stop_bare
}

do_enable() {
	if use_launchd; then
		write_plist
		do_start
		say "it will start by itself at every login"
	elif use_systemd; then
		write_unit
		systemctl --user daemon-reload
		systemctl --user enable pi-magpie-bot >/dev/null 2>&1
		do_start
		say "it will start by itself at every login"
		command -v loginctl >/dev/null 2>&1 && loginctl show-user "$USER" 2>/dev/null | grep -q '^Linger=yes' ||
			say "to keep it running while nobody is logged in: sudo loginctl enable-linger $USER"
	else
		do_start
		say "no service manager here, so it is running but will not start again after a reboot"
	fi
}

do_disable() {
	if use_launchd; then
		launchctl bootout "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || true
		rm -f "$PLIST"
	elif use_systemd; then
		systemctl --user disable --now pi-magpie-bot >/dev/null 2>&1 || true
		rm -f "$UNIT"
		systemctl --user daemon-reload || true
	fi
	stop_bare
}

case "${1:-status}" in
	status)
		if is_running; then
			if curl -fsS --noproxy '*' --max-time 2 "$(url)" >/dev/null 2>&1; then
				say "running: $(url)"
			else
				say "started, but the chat page is not answering yet (see: pi-magpie-bot logs)"
			fi
		else
			say "not running (start it with: pi-magpie-bot start)"
		fi
		;;
	start) do_start ;;
	stop) do_stop ;;
	restart) do_stop; do_start ;;
	enable) do_enable ;;
	disable) do_disable ;;
	logs) touch "$LOG"; exec tail -n 100 -f "$LOG" ;;
	url) url ;;
	open)
		if [ "$OS" = Darwin ]; then open "$(url)"; else xdg-open "$(url)" 2>/dev/null || echo "$(url)"; fi
		;;
	update)
		say "updating"
		exec bash -c 'curl -fsSL https://raw.githubusercontent.com/mazihua-lgtm/pi-magpie-bot/main/get.sh | bash'
		;;
	uninstall)
		do_disable
		rm -f "$HOME/.local/bin/pi-magpie-bot"
		rm -rf "$ROOT/app" "$ROOT/app.old" "$ROOT/node" "$ROOT/tools" "$ROOT/run.sh" "$ROOT/bot.log" "$ROOT/bot.log.1"
		if [ "${2:-}" = --purge ]; then
			rm -rf "$ROOT"
			say "removed everything, your chats and memory too"
		else
			say "removed the program; your chats and memory are still in $ROOT (delete the folder to erase them)"
			say "magpie and its free-model plugin were left alone"
			rm -f "$ROOT/pi-magpie-bot"
		fi
		;;
	-h | --help | help) sed -n '2,9p' "$SELF" | sed 's/^# \{0,1\}//' ;;
	*) die "unknown command: $1 (try: pi-magpie-bot help)" ;;
esac
